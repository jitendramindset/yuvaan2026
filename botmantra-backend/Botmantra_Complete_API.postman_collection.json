          "listen": "prerequest",
          "script": {
            "exec": [
              "const now = new Date();",
              "const expiresAt = new Date(Date.now() + 60 * 60 * 1000).toISOString();",
              "pm.collectionVariables.set('test_reset_id', pm.variables.replaceIn('{{$randomUUID}}'));",
              "pm.collectionVariables.set('test_reset_email', `test+${Date.now()}@example.com`);",
              "pm.collectionVariables.set('test_reset_token', pm.variables.replaceIn('{{$randomUUID}}').replace(/-/g, ''));",
              "pm.collectionVariables.set('test_reset_otp', Math.floor(100000 + Math.random() * 900000).toString());",
              "pm.collectionVariables.set('test_reset_expires_at', expiresAt);",
              "pm.collectionVariables.set('test_reset_created_at', now.toISOString());"
            ]
          }
        }
      ],
