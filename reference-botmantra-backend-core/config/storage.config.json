{
  "storage": {
    "ledger": {
      "engine": "leveldb",
      "path": "./data/leveldb",
      "writeBatchSize": 1000
    },
    "faiss": {
      "enabled": true,
      "indexPath": "./data/faiss",
      "dimension": 1536,
      "shardSize": 100000
    },
    "blobs": {
      "path": "./data/blobs",
      "encryption": "AES-256-GCM",
      "contentAddressing": true
    },
    "backup": {
      "centralServer": "https://backup.example.com/upload",
      "retentionDays": 7
    }
  },
  "security": {
    "kdf": {
      "algorithm": "argon2id",
      "memory": 65536,
      "iterations": 3
    },
    "signing": {
      "algorithm": "ed25519"
    }
  }
}
